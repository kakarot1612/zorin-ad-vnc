# ==============================================================================
# Zorin OS AD & Enterprise Tool - Environment Configuration Template
# Copy this file to .env and configure your environment variables:
#   cp .env.example .env
#   chmod 600 .env
#
# SECURITY WARNING:
# - NEVER commit the actual .env file to Git!
# - All sensitive credentials, IPs, and server names must be kept in .env only.
# ==============================================================================

# Active Directory Domain Controller Configuration
# AD_DOMAIN=example.com
# AD_DC1=192.168.1.10
# AD_DC2=192.168.1.11

# Windows File Server (SMB/CIFS)
# SMB_SERVER=192.168.1.20
# SMB_SHARE=Data

# Windows Print Server / Network Printer
# PRINT_SERVER=192.168.1.25
# PRINTER_IP=192.168.1.30
